<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="2.0.120" />
  </ItemGroup>

  <!-- Exclude sample projects and session artifacts from the main build's Compile items
       so their source files aren't accidentally included in the CLI project. -->
  <ItemGroup>
    <Compile Remove="samples\**\*.cs" />
    <Compile Remove="sessions\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove=".github\**\*.cs" />
    <Compile Remove="scripts\**\*.cs" />
  </ItemGroup>

</Project>
